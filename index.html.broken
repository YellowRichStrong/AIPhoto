<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F9K4YK9LXE"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F9K4YK9LXE');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>AI Model Hub - Model Leaderboard | Cost Calculator | Model Comparison</title>
    <meta name="description" content="AI Model Hub provides model leaderboard, cost calculator, and model comparison tools to help you choose the best AI models.">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        // ... existing code (all CSS remains the same) ...
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <i class="fas fa-brain"></i>
                AI Model Hub
            </div>
            <ul class="nav-menu">
                <li><a href="#" class="nav-link active" onclick="showTab('leaderboard')"><i class="fas fa-trophy"></i> Model Leaderboard</a></li>
                <li><a href="#" class="nav-link" onclick="showTab('calculator')"><i class="fas fa-calculator"></i> Cost Calculator</a></li>
                <li><a href="#" class="nav-link" onclick="showTab('compare')"><i class="fas fa-balance-scale"></i> Model Comparison</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <!-- Module 1: Model Leaderboard -->
        <div id="leaderboard" class="tab-content active">
            <div class="module-header">
                <h1 class="module-title">Best Text Generation Model Leaderboard</h1>
                <p class="module-description">The AIBase Model Leaderboard is based on comprehensive data from authoritative evaluation platforms (such as MMLU, etc.), showcasing the latest performance of global AI models. The leaderboard data is updated monthly.</p>
            </div>

            <div class="leaderboard-filters">
                <div class="filter-tabs">
                    <button class="filter-tab active"><i class="fas fa-comment-dots"></i> Text Generation</button>
                    <button class="filter-tab"><i class="fas fa-video"></i> Text to Video</button>
                    <button class="filter-tab"><i class="fas fa-image"></i> Text to Image</button>
                    <button class="filter-tab"><i class="fas fa-film"></i> Image to Video</button>
                    <button class="filter-tab"><i class="fas fa-code"></i> Web Development</button>
                </div>
            </div>

            <div class="leaderboard-table">
                <table>
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i> Rank</th>
                            <th><i class="fas fa-robot"></i> Model</th>
                            <th><i class="fas fa-building"></i> Provider</th>
                            <th><i class="fas fa-certificate"></i> License</th>
                            <th><i class="fas fa-star"></i> Score</th>
                        </tr>
                    </thead>
                    <tbody id="leaderboardData">
                        <!-- Data will be populated by JS -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Module 2: Cost Calculator -->
        <div id="calculator" class="tab-content">
            <div class="module-header">
                <h1 class="module-title">Model Cost Calculator</h1>
                <p class="module-description">Calculate the cost of using different AI models to help you choose the most cost-effective solution.</p>
            </div>

            <div class="calculator-container">
                <div class="calculator-panel">
                    <h3 style="margin-bottom: 1.5rem;">Input Parameters</h3>
                    
                    <div class="form-group">
                        <label class="form-label">Select Model</label>
                        <select class="form-select" id="modelSelect">
                            <option value="gpt4">GPT-4 Turbo</option>
                            <option value="gpt35">GPT-3.5 Turbo</option>
                            <option value="claude3">Claude 3 Opus</option>
                            <option value="gemini">Gemini Pro</option>
                            <option value="qwen">Qwen Max</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Input Tokens</label>
                        <input type="number" class="form-input" id="inputTokens" value="1000" placeholder="Enter input tokens">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Output Tokens</label>
                        <input type="number" class="form-input" id="outputTokens" value="1000" placeholder="Enter output tokens">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Number of Calls</label>
                        <input type="number" class="form-input" id="callCount" value="1000" placeholder="Enter number of calls">
                    </div>

                    <button class="btn-calculate" onclick="calculateCost()">
                        <i class="fas fa-calculator"></i> Calculate Cost
                    </button>
                </div>

                <div class="result-panel">
                    <h3 class="result-title">Estimated Total Cost</h3>
                    <div class="result-value" id="totalCost">$0.00</div>
                    
                    <div class="result-details">
                        <div class="result-item">
                            <span>Input Cost:</span>
                            <span id="inputCost">$0.00</span>
                        </div>
                        <div class="result-item">
                            <span>Output Cost:</span>
                            <span id="outputCost">$0.00</span>
                        </div>
                        <div class="result-item">
                            <span>Per Call Cost:</span>
                            <span id="perCallCost">$0.00</span>
                        </div>
                        <div class="result-item">
                            <span>Per Million Tokens:</span>
                            <span id="perMillionCost">$0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Module 3: Model Comparison -->
        <div id="compare" class="tab-content">
            <div class="module-header">
                <h1 class="module-title">Model Comparison</h1>
                <p class="module-description">Compare parameters, performance, and pricing of different AI models to help you make an informed decision.</p>
            </div>

            <div class="compare-header">
                <h3 style="margin-bottom: 1rem;">Select Models to Compare (up to 3)</h3>
                <div class="model-selector">
                    <select class="form-select" id="compareModel1">
                        <option value="gpt4">GPT-4 Turbo</option>
                        <option value="claude3">Claude 3 Opus</option>
                        <option value="gemini">Gemini Pro</option>
                    </select>
                    <select class="form-select" id="compareModel2">
                        <option value="claude3">Claude 3 Opus</option>
                        <option value="gpt4">GPT-4 Turbo</option>
                        <option value="gemini">Gemini Pro</option>
                    </select>
                    <select class="form-select" id="compareModel3">
                        <option value="gemini">Gemini Pro</option>
                        <option value="gpt4">GPT-4 Turbo</option>
                        <option value="claude3">Claude 3 Opus</option>
                    </select>
                </div>
            </div>

            <div class="compare-table" id="compareTableContainer">
                <!-- Comparison table will be generated by JS -->
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <!-- About Us -->
            <div class="footer-section">
                <h3 class="footer-title">
                    <i class="fas fa-info-circle"></i>
                    About Us
                </h3>
                <div class="footer-text">
                    <p>AI Model Hub is dedicated to providing developers and businesses with the most comprehensive and accurate AI model information and comparison services.</p>
                    <p>Based on comprehensive data from authoritative evaluation platforms (such as MMLU, etc.), we showcase the latest performance of global AI models, with leaderboard data updated monthly.</p>
                    <p>Whether you're selecting models, evaluating costs, or comparing performance, we provide professional reference data.</p>
                </div>
            </div>

            <!-- Privacy Policy -->
            <div class="footer-section">
                <h3 class="footer-title">
                    <i class="fas fa-shield-alt"></i>
                    Privacy Policy
                </h3>
                <div class="footer-text">
                    <p>We highly value your privacy and commit to:</p>
                    <p><i class="fas fa-check-circle"></i> Not collecting any personally sensitive information</p>
                    <p><i class="fas fa-check-circle"></i> Using only Google Analytics for anonymous visit statistics</p>
                    <p><i class="fas fa-check-circle"></i> All data is used solely to optimize user experience</p>
                    <p><i class="fas fa-check-circle"></i> Never sharing your information with third parties</p>
                    <p>By using this site, you agree to our privacy policy.</p>
                </div>
            </div>

            <!-- Contact Us -->
            <div class="footer-section">
                <h3 class="footer-title">
                    <i class="fas fa-envelope"></i>
                    Contact Us
                </h3>
                <div class="footer-text">
                    <p>For any questions, suggestions, or collaboration inquiries, feel free to contact us:</p>
                    <div class="footer-email">
                        <i class="fas fa-paper-plane"></i>
                        <a href="mailto:tankeapp@gmail.com" class="footer-link">tankeapp@gmail.com</a>
                    </div>
                    <p style="margin-top: 1.5rem;">We typically respond to emails within 24-48 hours.</p>
                    <p><i class="fas fa-clock"></i> Business Hours: Monday to Friday 9:00-18:00 (UTC+8)</p>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2025 AI Model Hub. All rights reserved. | Monthly updates with the latest AI model data</p>
        </div>
    </footer>

    <script src="js/model-center.js"></script>
</body>
</html>